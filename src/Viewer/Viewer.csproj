<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The AOT compiler follows SDK assemblies; link our small application
         recipe/adapter into the entry assembly. No local format parser. -->
    <Compile Include="../Pso/*.cs" Link="Pso/%(Filename)%(Extension)" />
    <ProjectReference Include="../../.dependencies/dolphindotnet/src/DolphinDotNet.GameCube/DolphinDotNet.GameCube.csproj" />
  </ItemGroup>
</Project>
